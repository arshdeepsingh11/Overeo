# ---- OVEREO backend settings (copy to .env and fill in) ----
NODE_ENV=production
PORT=4000
# PostgreSQL 13+ — any host. Add ?sslmode=require for a managed database.
DATABASE_URL=postgres://overeo:CHANGE_ME@localhost:5432/overeo
# at least 32 random characters:  openssl rand -base64 48
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# the website address(es) that may use the API, comma-separated
ALLOWED_ORIGINS=https://overeo.example.com
APP_URL=https://overeo.example.com
COOKIE_SECURE=true
# COOKIE_DOMAIN=.overeo.example.com   (only if web and API are on different subdomains)
SESSION_DAYS=30
STORAGE_DIR=/var/lib/overeo/files
MAX_FILE_MB=15
MAX_PROFILES=8
AUTO_MIGRATE=true
TRUST_PROXY=true
# console = emails written to the log until a mail server is connected
EMAIL_TRANSPORT=console
