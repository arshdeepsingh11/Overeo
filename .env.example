# =====================================================================
# OVEREO — local secrets. Copy to .env.local and fill in. This example file is safe to commit.
# On Vercel: Project → Settings → Environment Variables → add the same
# names (Production + Preview), then redeploy.
# =====================================================================

# --- Overeo SI live brain: Xevyo (server-side only — no NEXT_PUBLIC_) ---
XEVYO_API_KEY=xk-your-key-here
XEVYO_BASE_URL=https://chat.xevyo.com/xevyo/v1
XEVYO_MODEL=xevyo
# Optional: a Xevyo Library project with OVEREO's guidelines & BioAro test info
XEVYO_PROJECT_ID=

# Set to 0 to keep Overeo SI fully on-device (no live brain)
NEXT_PUBLIC_SI_LIVE=1

# --- Data backend (leave as "local" until the OVEREO API exists) ---
NEXT_PUBLIC_DATA_BACKEND=local
NEXT_PUBLIC_API_URL=

# --- BioAro Labs on Shopify (optional — enables in-app ordering) ---
NEXT_PUBLIC_SHOPIFY_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
